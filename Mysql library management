    --  Create Database: First, a database named library_management is created to store all library information.
 
CREATE DATABASE library_management;
USE library_management;

 --   Users Table: The users table stores user details such as user ID, name, email, phone number, and address.gitr
CREATE TABLE users (
    user_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    phone VARCHAR(15),
    address VARCHAR(255)
);
   
    -- Books Table: The books table stores book details such as book ID, title, author, category, ISBN, total copies, and available copies.

CREATE TABLE books (
    book_id INT PRIMARY KEY AUTO_INCREMENT,
    title VARCHAR(200) NOT NULL,
    author VARCHAR(100) NOT NULL,
    category VARCHAR(100),
    isbn VARCHAR(20) UNIQUE,
    total_copies INT NOT NULL DEFAULT 1,
    available_copies INT NOT NULL DEFAULT 1
);
    --   Transactions Table: The transactions table records every book issue and return. It contains the user ID, book ID, issue date, due date, return date, and status.
    --    Relationship: The user_id and book_id in the transactions table are foreign keys connected to the users and books tables.
      
CREATE TABLE transactions (
    transaction_id INT PRIMARY KEY AUTO_INCREMENT,
    book_id INT NOT NULL,
    user_id INT NOT NULL,
    issue_date DATE NOT NULL,
    due_date DATE NOT NULL,
    return_date DATE NULL,
    status ENUM('ISSUED', 'RETURNED') DEFAULT 'ISSUED',

    FOREIGN KEY (book_id)
        REFERENCES books(book_id),

    FOREIGN KEY (user_id)
        REFERENCES users(user_id)
);

